PORT=5000
# development | production. Production refuses to start with a weak JWT_SECRET and blocks db:reset.
NODE_ENV=development
# Comma-separated list. Leave unset to allow https://*.indigocomputers.in and localhost.
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_NAME=microbiology_db
DB_USER=postgres
DB_PASSWORD=change_me
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
# Static Super Admin login (username: superadmin). Applied by npm run db:seed / db:superadmin.
SUPERADMIN_DEFAULT_PASSWORD=change_me
